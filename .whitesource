{
  "scanSettings": {
    "configMode": "AUTO",
    "baseBranches": ["main"],
    "enableLicenseViolations": true,
    "enableReachability": true,
    "reachabilityScanDelayHours": 24,
    "enableIaC": true
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "licenseCheckRunConclusionLevel": "failure",
    "iacCheckRunConclusionLevel": "failure",
    "displayMode": "diff",
    "failOnVulnerabilityMinSeverity": "Low",
    "strictMode": "failOnWarning",
    "strictModeInfo": true,
    "useMendCheckNames": true
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "VULNERABILITY",
    "displayLicenseViolations": true,
    "iacIssues": true
  },
  "remediateSettings": {
    "enableRenovate": false,
    "workflowRules": {
      "enabled": true,
      "minVulnerabilitySeverity": "LOW"
    }
  },
  "leastVulnerablePackageSettings": {
    "enabled": true
  },
  "scanSettingsSAST": {
    "enableScan": true,
    "enableSecretsScan": true,
    "scanPullRequests": true,
    "incrementalScan": false,
    "baseBranches": ["main"],
    "findingSuppressions": "requireApproval"
  },
  "checkRunSettingsSAST": {
    "checkRunConclusionLevel": "failure",
    "severityThreshold": "low"
  },
  "issueSettingsSAST": {
    "issueType": "finding",
    "minSeverityLevel": "low"
  }
}
